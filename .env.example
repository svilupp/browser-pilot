# browser-pilot environment variables
#
# Copy to `.env` and fill in the values you need. Bun auto-loads `.env`;
# the built `dist/cli.mjs` running under Node loads it via `loadDotenv()`
# in `src/cli/index.ts` (opt out with BROWSER_PILOT_NO_DOTENV=1).

# BrowserBase provider (https://browserbase.com)
BROWSERBASE_API_KEY=
# Optional when the API key has exactly one project.
BROWSERBASE_PROJECT_ID=

# Browser Use provider (https://browser-use.com)
BROWSER_USE_API_KEY=

# Browserless provider (https://browserless.io)
BROWSERLESS_API_KEY=

# Cloudflare Access service token, used by `bp connect --cf-access`.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Used by tooling/scripts that call the OpenAI API directly (not required
# for core browser-pilot functionality).
OPENAI_API_KEY=
